{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    // Źródła POC (`src/core`, `src/editor`) są przeniesione bez przepisywania
    // i pisane bez tych dwóch flag. Aplikacja nie kompiluje ich swoimi ustawieniami:
    // widzi tylko `src/index.ts` i deklaracje `src/register.d.ts` (pole `exports`).
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src"]
}
