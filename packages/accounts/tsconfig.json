{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Skrypty uruchamia Node bez bundlera (usuwanie typów), więc importy mają rozszerzenie .ts,
    // a składnia TypeScriptu musi dać się po prostu usunąć.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "integration", "vitest.config.ts", "vitest.integration.config.ts"]
}
