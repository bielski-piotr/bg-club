# Dane pierwszego administratora dla `pnpm bootstrap:admin` (PRD AUTH-3).
# Skopiuj do supabase/seed/.env (plik nie trafia do repozytorium) i uzupełnij.
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
# Opcjonalne, min. 12 znaków. Puste = skrypt wygeneruje losowe hasło i wypisze je jeden raz.
BOOTSTRAP_ADMIN_PASSWORD=

# Tylko dla `pnpm bootstrap:admin` (bez :local), np. przy instalacji produkcyjnej:
# adres projektu i klucz service role / secret z panelu Supabase (Project Settings → API Keys).
# Klucz omija RLS: trzymaj go wyłącznie w tym pliku lub w zmiennych środowiskowych.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
