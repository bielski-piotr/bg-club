{
  "name": "bg-club",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @bg-club/web dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @bg-club/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "eslint-plugin-solid": "~0.20.0",
    "oxlint": "~1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
