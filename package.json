{
  "name": "bg-club",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @bg-club/web dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @bg-club/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "bootstrap:admin": "pnpm --filter @bg-club/accounts bootstrap:admin",
    "bootstrap:admin:local": "pnpm --filter @bg-club/accounts bootstrap:admin --local",
    "db:lint": "supabase db lint --level warning",
    "backup:export": "node scripts/backup/backup.mjs export",
    "backup:verify": "node scripts/backup/backup.mjs verify",
    "backup:restore": "node scripts/backup/backup.mjs restore",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.20.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
