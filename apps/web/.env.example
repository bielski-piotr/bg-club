# Konfiguracja frontendu BG Club.
# Skopiuj do apps/web/.env.local i uzupełnij. Plik .env.local nie trafia do repozytorium.
#
# Lokalnie: wartości wypisuje `pnpm db:start` (albo `pnpm exec supabase status`):
#   API URL  -> VITE_SUPABASE_URL
#   anon key -> VITE_SUPABASE_ANON_KEY
# Produkcyjnie: panel Supabase -> Project Settings -> API.
#
# Klucz anon jest publiczny z założenia (dostęp chroni RLS).
# Nigdy nie wpisuj tu klucza service_role.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
