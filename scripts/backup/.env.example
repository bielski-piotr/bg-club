# Zapisz uzupełnioną kopię poza repo w prywatnym katalogu operatora.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<PRIVATE_SERVICE_ROLE>
PGHOST=<HOST_FROM_CONNECT>
PGPORT=5432
PGDATABASE=postgres
PGUSER=<USER_FROM_CONNECT>
PGPASSWORD=<PRIVATE_DB_PASSWORD>
PGSSLMODE=require
PGCONNECT_TIMEOUT=15
# Ustaw yes dopiero po rzeczywistym zatrzymaniu wszystkich zapisów.
BG_BACKUP_QUIESCED=no
# Restore wymaga osobnego pustego projektu, dokładny origin bez końcowego /.
BG_RESTORE_TARGET=https://<TARGET_PROJECT_REF>.supabase.co
